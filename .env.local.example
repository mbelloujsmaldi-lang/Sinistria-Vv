# Copiez ce fichier en .env.local et remplissez avec les valeurs de votre projet Supabase
# (Project Settings > API dans le tableau de bord Supabase)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-clé-anon-ici

# Project Settings > API > service_role (secret, jamais côté client)
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service_role-ici

# Clé partagée pour POST /api/calculer (générez une valeur aléatoire longue,
# la même doit être configurée côté Sinistria-Site)
VV_API_KEY=votre-clé-api-secrète-ici
